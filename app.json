{
  "expo": {
    "name": "MinutoCerto",
    "slug": "minutocerto",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/73be52f4-6f49-4532-9697-6777016c8397"
    },
    "android": {
      "package": "com.minutocerto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#10212E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "73be52f4-6f49-4532-9697-6777016c8397"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#1B8A5A",
          "sounds": [
            "./assets/sounds/bip1.wav",
            "./assets/sounds/bip2.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O MinutoCerto usa a câmera para ler o QR Code dos brinquedos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o MinutoCerto use o Face ID"
        }
      ]
    ],
    "ios": {}
  }
}